# إعداد Firebase للويب — مشروع «who hid the file».
#
# هذه القيم ليست أسرارًا: Vite يدمجها في حزمة العميل، فيقرؤها أي زائر من أي
# تطبيق ويب. الحماية كلها في firebase/database.rules.json — لا في إخفاء المفتاح.
# لذلك يُلتزم بها في المستودع ليبنيها Vercel بلا إعداد يدوي في لوحته.
#
# ما يجب ألّا يدخل هنا أبدًا: مفاتيح Service Account، أو أي مفتاح خادم.
#
# `.env` و`.env.local` مستثنيان في .gitignore ويبقيان للتجارب المحلية.

VITE_FIREBASE_API_KEY=AIzaSyDGl2i79EXE7YiLJVnOo4Atdl0rT2kLg7A
VITE_FIREBASE_AUTH_DOMAIN=who-hid-the-file.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://who-hid-the-file-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=who-hid-the-file
VITE_FIREBASE_APP_ID=1:436866283475:web:dfe5ea9fc24611dca4a126
